# GlobeTrotter Frontend — Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL — used by Vite proxy to forward /api requests
# For local development: leave as default (proxied to localhost:5000)
# For production deployment: set to your deployed backend URL
VITE_API_URL="http://localhost:5000"

# Optional: Google Maps API key for enhanced map features
# VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
