# GlobeTrotter Backend — Environment Configuration
# Copy this file to .env and fill in your values

# SQLite database path (relative to Backend/ folder)
DATABASE_URL="file:./dev.db"

# Server port (default: 5000)
PORT=5000

# CORS allowed origins — set to your frontend URL in production
# Example for local dev: http://localhost:3000
# Example for production: https://yourdomain.com
FRONTEND_URL="http://localhost:3000"

# Optional: Node environment
NODE_ENV="development"
