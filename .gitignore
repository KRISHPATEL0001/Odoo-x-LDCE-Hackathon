# GlobeTrotter — Root .gitignore

# Node modules (both backend and frontend)
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/

# Environment files — NEVER commit secrets
.env
**/.env
!**/.env.example

# SQLite database files — these are runtime data, not source code
*.db
*.db-shm
*.db-wal
**/dev.db
**/prisma/*.db

# OS artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE artifacts
.vscode/settings.json
.idea/
*.swp
*.swo

# AI tool artifacts (never commit these)
.agents/
.claude/
.windsurf/
skills-lock.json
**/skills-lock.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Prisma generated client (regenerated on install)
**/generated/prisma/

# Coverage reports
coverage/

# Temporary
*.tmp
*.temp
